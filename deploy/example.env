# Copy to deploy/.env and fill in the blanks. Nothing here is a real
# secret — dev/setup-secrets.sh generates the JWT keypair and internal key
# for you; SEP10_SIGNING_SEED and KEEPER_SECRET_SEED are testnet-only
# keypairs you create with `stellar keys generate`.

# ---- Shared ----------------------------------------------------------
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
INTERNAL_API_KEY=

# ---- pay-chain-gateway --------------------------------------------------
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
CHAIN_GATEWAY_URL=http://pay-chain-gateway:8082

# ---- Postgres ----------------------------------------------------------
POSTGRES_USER=localpayment
POSTGRES_PASSWORD=localpayment
POSTGRES_DB=localpayment
POSTGRES_HOST_PORT=5434
DATABASE_URL=postgres://localpayment:localpayment@postgres:5432/localpayment?sslmode=disable

# ---- pay-auth-service (SEP-10) ------------------------------------------
# S... secret of an account that owns HOME_DOMAIN's stellar.toml SIGNING_KEY.
SEP10_SIGNING_SEED=
HOME_DOMAIN=localhost
WEB_AUTH_DOMAIN=localhost
JWT_PRIVATE_KEY_PATH=/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/secrets/jwt_public.pem

# ---- pay-cheque-service / pay-scheduler-service (pay-escrow contract) ---
# From `stellar contract deploy` — see contracts/soroban/pay-escrow/README.md.
PAY_ESCROW_CONTRACT_ID=
# The MVP asset (plan's Açık Varsayım #1): testanchor.stellar.org's SRT, or
# your own anchor's SAC address once you point ANCHOR_DOMAIN at it.
ASSET_SAC_CONTRACT_ID=
ASSET_CODE=SRT
ASSET_ISSUER=
ASSET_DECIMALS=7

# ---- pay-anchor-service --------------------------------------------------
ANCHOR_ID=default
ANCHOR_DOMAIN=testanchor.stellar.org

# ---- pay-scheduler-service ------------------------------------------------
# S... secret of a funded testnet account. Pays network fees for
# permissionless refund() calls only — never a custodial key. See
# docs/reference/platform/anchor-entegrasyonu.md "Keeper hesabı".
KEEPER_SECRET_SEED=
SWEEP_INTERVAL_SECONDS=60
BUMP_INTERVAL_SECONDS=21600
