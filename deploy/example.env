# Copy to deploy/.env and fill in the blanks. Nothing here is a real
# secret — dev/setup-secrets.sh generates the JWT keypair and internal key
# for you; SEP10_SIGNING_SEED and KEEPER_SECRET_SEED are testnet-only
# keypairs you create with `stellar keys generate`.

# ---- Shared ----------------------------------------------------------
# The client learns this from /sync at runtime (SERVICE.md #20), so
# changing it here is enough for the whole backend — no client rebuild
# needed. The Flutter build's own --dart-define=NETWORK_PASSPHRASE only
# covers the brief window before the first sync.
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
INTERNAL_API_KEY=

# ---- pay-chain-gateway --------------------------------------------------
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Testnet friendbot (SERVICE.md #24). Its own host, NOT Horizon's /friendbot
# redirect — the SSRF allow-list rejects redirect hops. Set empty to disable.
FRIENDBOT_URL=https://friendbot.stellar.org
CHAIN_GATEWAY_URL=http://pay-chain-gateway:8082

# ---- Postgres ----------------------------------------------------------
POSTGRES_USER=localpayment
POSTGRES_PASSWORD=localpayment
POSTGRES_DB=localpayment
POSTGRES_HOST_PORT=5434
DATABASE_URL=postgres://localpayment:localpayment@postgres:5432/localpayment?sslmode=disable

# ---- pay-auth-service (SEP-10) ------------------------------------------
# S... secret of an account that owns HOME_DOMAIN's stellar.toml SIGNING_KEY.
SEP10_SIGNING_SEED=
HOME_DOMAIN=localhost
WEB_AUTH_DOMAIN=localhost
JWT_PRIVATE_KEY_PATH=/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/secrets/jwt_public.pem
# Best-effort testnet friendbot fund on a wallet's first successful SEP-10
# login (SERVICE.md #24) — never blocks login, never applies on mainnet
# (defaults off there even if left unset). Set to false to disable outright.
FUND_NEW_ACCOUNTS=true

# ---- pay-cheque-service / pay-scheduler-service (pay-escrow contract) ---
# From `stellar contract deploy` — see contracts/soroban/pay-escrow/README.md.
PAY_ESCROW_CONTRACT_ID=
# The app's one asset is native XLM: no issuer, no trustline, no anchor
# ramp needed. The SAC contract address below is native XLM's fixed testnet
# wrapper (`stellar contract id asset --asset native --network testnet`).
# To point a deployment at an issued asset (e.g. USDC) instead, set ASSET_CODE
# + ASSET_ISSUER + ASSET_SAC_CONTRACT_ID (`stellar contract id asset --asset
# <CODE>:<ISSUER> --network testnet`) together — the frontend's matching
# PAY_ASSET_CODE/PAY_ASSET_ISSUER build-time defines must change with it.
ASSET_SAC_CONTRACT_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
ASSET_CODE=native
ASSET_ISSUER=
ASSET_DECIMALS=7

# ---- pay-anchor-service --------------------------------------------------
# The anchor's own asset is independent from the platform asset above: the
# TR mock anchor only ever ramps USDC via SEP-6/24 against TRY, regardless
# of what cheques/pool are denominated in (ASSET_CODE/ASSET_ISSUER stays
# native XLM). Change ANCHOR_ASSET_* together only if you point this at a
# different anchor that ramps a different asset.
ANCHOR_ID=default
ANCHOR_DOMAIN=tr-mock-anchor.fly.dev
ANCHOR_ASSET_CODE=USDC
ANCHOR_ASSET_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
ANCHOR_ASSET_DECIMALS=7

# ---- pay-scheduler-service ------------------------------------------------
# S... secret of a funded testnet account. Pays network fees for
# permissionless refund() calls only — never a custodial key. See
# docs/reference/platform/anchor-entegrasyonu.md "Keeper hesabı".
KEEPER_SECRET_SEED=
SWEEP_INTERVAL_SECONDS=60
BUMP_INTERVAL_SECONDS=21600
